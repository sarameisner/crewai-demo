## Copy this file to `.env` (which is gitignored) and edit values.
##
## Per-agent model endpoint routing (OpenAI-compatible; works with Ollama).
## Each agent will call the base_url you assign here.
##
## Note: this must be valid JSON on a single line.
CREWAI_AGENT_BASE_URLS={"architect":"http://10.136.133.45:11434/v1","tech_lead":"http://localhost:11434/v1","coder":"http://localhost:11434/v1","tester":"http://localhost:11434/v1","docs_ai":"http://localhost:11434/v1","devops_ai":"http://localhost:11434/v1"}

## Fallback if an agent is missing from CREWAI_AGENT_BASE_URLS
CREWAI_DEFAULT_BASE_URL=http://localhost:11434/v1



## Optional: per-agent model names (must exist on that agent's base_url host).
## Note: this must be valid JSON on a single line.
# CREWAI_AGENT_MODELS={"architect":"qwen3:1.7b","tech_lead":"llama3.2:3b","coder":"qwen2.5-coder:7b"}

## Model name used across all agents (must exist on each Ollama host)
CREWAI_MODEL_NAME=qwen3:1.7b

## Ollama/OpenAI-compatible servers often accept any key; keep for compatibility
OPENAI_API_KEY=ollama

